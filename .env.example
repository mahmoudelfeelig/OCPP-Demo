# Shared local development settings
COMPOSE_PROJECT_NAME=ocpp-backend-demo
APP_ENV=development
APP_NAME=ocpp-backend-demo
APP_VERSION=0.1.0

# Local demo only. This creates sample sites, stations, messages, and demo users.
# Keep this false in production and use ADMIN_BOOTSTRAP_* instead.
SEED_DEMO_DATA=true

# Production/bootstrap path. Leave blank for local seeded demos.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

POSTGRES_DB=ocpp_demo
POSTGRES_USER=ocpp_demo
POSTGRES_PASSWORD=ocpp_demo
DATABASE_URL=postgresql+psycopg://ocpp_demo:ocpp_demo@postgres:5432/ocpp_demo

REDIS_URL=redis://redis:6379/0

BACKEND_PORT=8000
FRONTEND_PORT=3000
SIMULATOR_PORT=9000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
BACKEND_INTERNAL_URL=http://backend:8000
SIMULATOR_INTERNAL_URL=http://simulator:9000

PUBLIC_API_BASE_URL=http://localhost:8080/api
PUBLIC_OCPP_BASE_URL=ws://localhost:8080/ocpp

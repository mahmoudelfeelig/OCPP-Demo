:8080 {
	encode zstd gzip

	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	handle_path /api/* {
		reverse_proxy backend:8000
	}

	handle /ocpp/* {
		reverse_proxy backend:8000
	}

	handle_path /simulator/* {
		reverse_proxy simulator:9000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

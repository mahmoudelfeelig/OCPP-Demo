# Server-only values for production-like deployments.
# Copy this to deploy/.env and never commit the real file.

APP_ENV=production
APP_NAME=ocpp-demo
APP_VERSION=0.1.0

POSTGRES_DB=ocpp_demo
POSTGRES_USER=ocpp_demo
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ocpp_demo:CHANGE_ME@postgres:5432/ocpp_demo
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me
JWT_ISSUER=ocpp-backend-demo
JWT_AUDIENCE=ocpp-backend-demo-web

PARTNER_WEBHOOK_SECRET=change-me
ADMIN_BOOTSTRAP_EMAIL=admin@localhost
ADMIN_BOOTSTRAP_PASSWORD=change-me
GHCR_OWNER=replace-me
IMAGE_TAG=latest

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

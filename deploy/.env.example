# Server-only values for production-like deployments.
# Copy this to deploy/.env and never commit the real file.

APP_ENV=production
APP_NAME=ocpp-demo
APP_VERSION=0.1.0

# Production must not seed demo data. Create the first admin with ADMIN_BOOTSTRAP_*,
# then clear those bootstrap values after the account exists.
SEED_DEMO_DATA=false

POSTGRES_DB=ocpp_demo
POSTGRES_USER=ocpp_demo
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ocpp_demo:CHANGE_ME@postgres:5432/ocpp_demo
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me
JWT_ISSUER=ocpp-backend-demo
JWT_AUDIENCE=ocpp-backend-demo-web

PARTNER_WEBHOOK_SECRET=change-me

# Map each station ID to a unique, random token of at least 32 characters.
# The backend stores only token hashes; the simulator reads this mapping to authenticate.
OCPP_STATION_TOKENS={"BER-001":"replace-with-unique-token-at-least-32-characters","BER-002":"replace-with-unique-token-at-least-32-characters","HAM-001":"replace-with-unique-token-at-least-32-characters","MUC-001":"replace-with-unique-token-at-least-32-characters"}

# First production admin only. Set both values for the first deploy, sign in,
# create normal admin accounts if needed, then remove these values and redeploy.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
